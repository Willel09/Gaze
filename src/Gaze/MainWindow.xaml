<Window x:Class="Gaze.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:Gaze"
        Title="Gaze" Width="1180" Height="780" MinWidth="980" MinHeight="680"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen"
        Icon="Assets/gaze.ico">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="372"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="SidebarPanel" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: a small eye that really looks at your cursor -->
                <StackPanel Orientation="Horizontal" Margin="24,24,24,16">
                    <Canvas x:Name="LogoEye" Width="44" Height="44" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gaze" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Desktop eyes that follow your cursor" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tabs: one section at a time instead of one long scroll -->
                <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="12" Padding="3" Margin="20,0,20,12">
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="TabScene" GroupName="tab" Style="{StaticResource TabItem}" IsChecked="True" Checked="OnTab" Tag="PageScene" AutomationProperties.Name="Scene">
                            <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" HorizontalAlignment="Center"/><TextBlock Text="Scene" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="tab" Style="{StaticResource TabItem}" Checked="OnTab" Tag="PageEyes" AutomationProperties.Name="Eyes">
                            <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" HorizontalAlignment="Center"/><TextBlock Text="Eyes" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="tab" Style="{StaticResource TabItem}" Checked="OnTab" Tag="PageBehave" AutomationProperties.Name="Behaviour">
                            <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" HorizontalAlignment="Center"/><TextBlock Text="Behaviour" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="tab" Style="{StaticResource TabItem}" Checked="OnTab" Tag="PageSystem" AutomationProperties.Name="System">
                            <StackPanel><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" HorizontalAlignment="Center"/><TextBlock Text="System" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0">
                    <Grid Margin="20,0,20,8">
<StackPanel x:Name="PageScene">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xEB9F;"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Wallpaper"/>
                                </StackPanel>
                                <Button x:Name="ChooseBtn" Style="{StaticResource SecondaryButton}" Click="OnChoose" Height="40">
                                    <TextBlock Text="Choose wallpaper"/>
                                </Button>
                                <TextBlock x:Name="FileName" Style="{StaticResource Caption}" Margin="2,10,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Text="JPG, PNG, WebP or BMP"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8F1;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Backgrounds"/>
                                    </StackPanel>
                                    <Button x:Name="SaveBgBtn" Style="{StaticResource Chip}" Click="OnSaveBackground" HorizontalAlignment="Right" Margin="0" Content="Save current"/>
                                </Grid>
                                <WrapPanel x:Name="LibraryPanel"/>
                                <TextBlock x:Name="LibraryEmpty" Style="{StaticResource Caption}" Text="Save a background to swap between favourites in one click. Each one remembers its own eyes."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE790;"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Looks"/>
                                </StackPanel>
                                <WrapPanel x:Name="LookChips"/>
                            </StackPanel>
                        </Border>

                        </StackPanel>
<StackPanel x:Name="PageEyes" Visibility="Collapsed">
<Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7B3;"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Eyes"/>
                                </StackPanel>
                                <CheckBox x:Name="CyclopsSwitch" Style="{StaticResource Switch}" Click="OnCyclops">
                                    <StackPanel>
                                        <TextBlock Text="Cyclops mode"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="One big eye instead of two"/>
                                    </StackPanel>
                                </CheckBox>
                                <g:LabeledSlider x:Name="SlCyclops" Label="Eye size" Minimum="0.05" Maximum="0.5" Visibility="Collapsed"/>
                                <Border x:Name="EyePicker" Background="#14FFFFFF" CornerRadius="10" Padding="2" Margin="0,8,0,0">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="PickLeft" GroupName="eye" Style="{StaticResource SegmentItem}" IsChecked="True" Checked="OnPickEye">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="LeftMark" Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Margin="0,0,6,0" Visibility="Collapsed"/>
                                                <TextBlock Text="Left eye"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="PickRight" GroupName="eye" Style="{StaticResource SegmentItem}" Checked="OnPickEye">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="RightMark" Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Margin="0,0,6,0" Visibility="Collapsed"/>
                                                <TextBlock Text="Right eye"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                                <TextBlock x:Name="EyeHint" Style="{StaticResource Caption}" Margin="2,10,0,14"/>

                                <g:LabeledSlider x:Name="SlWidth"  Label="Eye width"  Minimum="0.3" Maximum="0.9"/>
                                <g:LabeledSlider x:Name="SlHeight" Label="Eye height" Minimum="0.1" Maximum="0.45"/>
                                <g:LabeledSlider x:Name="SlIris"   Label="Iris size"  Minimum="0.05" Maximum="0.18"/>
                                <g:LabeledSlider x:Name="SlPupil"  Label="Pupil size" Minimum="0.25" Maximum="0.65"/>
                                <g:LabeledSlider x:Name="SlTilt"   Label="Tilt" Minimum="-20" Maximum="20" Scale="1" Unit="°"/>
                                <g:LabeledSlider x:Name="SlLid"    Label="Lid shadow" Minimum="0" Maximum="1"/>
                                <g:LabeledSlider x:Name="SlDroop"  Label="Eyelid droop" Minimum="0" Maximum="0.6"/>
                                <Button Style="{StaticResource QuietButton}" Click="OnAutoFit" HorizontalAlignment="Left" Padding="10,0" Height="32">
                                    <TextBlock Text="Auto-fit eye shape"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE790;"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Appearance"/>
                                </StackPanel>
                                <TextBlock Text="Iris colour" FontSize="13"/>
                                <WrapPanel x:Name="IrisSwatches" Margin="0,8,0,8"/>
                                <TextBlock Text="Eye white colour" FontSize="13"/>
                                <WrapPanel x:Name="ScleraSwatches" Margin="0,8,0,8"/>
                                <TextBlock Text="Pupil shape" FontSize="13" Margin="0,0,0,8"/>
                                <Border Background="#14FFFFFF" CornerRadius="10" Padding="2">
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="PupilRound" GroupName="pupil" Style="{StaticResource SegmentItem}" Content="Round" Checked="OnPupil"/>
                                        <RadioButton x:Name="PupilSlit" GroupName="pupil" Style="{StaticResource SegmentItem}" Content="Slit" Checked="OnPupil"/>
                                        <RadioButton x:Name="PupilWide" GroupName="pupil" Style="{StaticResource SegmentItem}" Content="Wide" Checked="OnPupil"/>
                                    </UniformGrid>
                                </Border>
                                <CheckBox x:Name="GlintSwitch" Style="{StaticResource Switch}" Click="OnGlint" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Highlight"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="The small reflection in the eye"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        </StackPanel>
<StackPanel x:Name="PageBehave" Visibility="Collapsed">
<Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE9E9;"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Behaviour"/>
                                </StackPanel>
                                <g:LabeledSlider x:Name="SlSens"   Label="Sensitivity" Minimum="0.4" Maximum="2.5" Scale="100"/>
                                <g:LabeledSlider x:Name="SlRange"  Label="Movement range" Minimum="0.2" Maximum="1"/>
                                <g:LabeledSlider x:Name="SlSmooth" Label="Smoothness" Minimum="0" Maximum="1"/>
                                <CheckBox x:Name="BlinkSwitch" Style="{StaticResource Switch}" Click="OnBlink">
                                    <StackPanel>
                                        <TextBlock Text="Blinking"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Blink every few seconds"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ClickSwitch" Style="{StaticResource Switch}" Click="OnClickBlink">
                                    <StackPanel>
                                        <TextBlock Text="Blink when you click"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="A quick reaction to every mouse click"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="CrazySwitch" Style="{StaticResource Switch}" Click="OnCrazy">
                                    <StackPanel>
                                        <TextBlock Text="Crazy mode"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Pupils look the exact opposite way from your cursor"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="IdleSwitch" Style="{StaticResource Switch}" Click="OnIdle">
                                    <StackPanel>
                                        <TextBlock Text="Idle life"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Look around when idle, fall asleep after 3 minutes"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        </StackPanel>
<StackPanel x:Name="PageSystem" Visibility="Collapsed">
<Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE713;"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="System"/>
                                </StackPanel>
                                <CheckBox x:Name="TrackSwitch" Style="{StaticResource Switch}" Click="OnTrackingSwitch">
                                    <StackPanel>
                                        <TextBlock Text="Eye tracking"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Off shows the still wallpaper"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="StartSwitch" Style="{StaticResource Switch}" Click="OnStartSwitch">
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Runs quietly in the tray"/>
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,12,0,8"/>
                                <Button x:Name="UpdateBtn" Style="{StaticResource SecondaryButton}" Click="OnUpdate" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="UpdateLabel" Text="Check for updates"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Click="OnOpenLog" HorizontalAlignment="Left" Padding="10,0" Height="32" Margin="0,6,0,0">
                                    <TextBlock Text="Open log file"/>
                                </Button>
                            </StackPanel>
                        </Border>
</StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="3" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="24,16,24,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}" Text="Not applied"/>
                        </StackPanel>
                        <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryButton}" Click="OnApply" Height="44">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" Margin="0,0,10,0"/>
                                <TextBlock Text="Apply to desktop" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuietButton}" Click="OnReset" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,10,0"/>
                                <TextBlock Text="Reset settings" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Stage -->
        <Grid Grid.Column="1" Margin="24,20,24,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Margin="4,0,4,14">
                <Border Background="#1AFFFFFF" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="12" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeCalibrate" GroupName="mode" Style="{StaticResource SegmentItem}" Content="Calibrate" IsChecked="True" Checked="OnMode"/>
                        <RadioButton x:Name="ModePreview" GroupName="mode" Style="{StaticResource SegmentItem}" Content="Preview" Checked="OnMode"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StageHint" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap"/>
            </Grid>

            <!-- The photo's own colours bleed softly into the stage -->
            <Border Grid.Row="1" CornerRadius="20" ClipToBounds="True" Background="#0E0E10" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                <Grid x:Name="StageHost" SizeChanged="OnStageSize">
                    <Image x:Name="Ambient" Stretch="UniformToFill" Opacity="0.42" IsHitTestVisible="False">
                        <Image.Effect><BlurEffect Radius="90" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect>
                    </Image>

                    <Border x:Name="StageFrame" CornerRadius="14" Background="Black" ClipToBounds="True"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                            BorderBrush="#26FFFFFF" BorderThickness="1">
                        <Border.Effect><DropShadowEffect BlurRadius="48" ShadowDepth="14" Direction="270" Opacity="0.55" Color="Black"/></Border.Effect>
                        <Grid x:Name="StageGrid" Background="Transparent"
                              MouseLeftButtonDown="OnStageDown" MouseMove="OnStageMove" MouseLeftButtonUp="OnStageUp">
                            <Grid x:Name="SceneHost"/>
                            <Canvas x:Name="Guides" IsHitTestVisible="False"/>
                            <Border x:Name="Loupe" Width="140" Height="140" CornerRadius="70" Visibility="Collapsed" IsHitTestVisible="False"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="White" BorderThickness="2">
                                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6"/></Border.Effect>
                                <Grid>
                                    <Line X1="70" Y1="58" X2="70" Y2="82" Stroke="White" StrokeThickness="1.5"/>
                                    <Line X1="58" Y1="70" X2="82" Y2="70" Stroke="White" StrokeThickness="1.5"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                        <Canvas x:Name="EmptyEye" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Pick a photo of a face" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Style="{StaticResource Caption}" FontSize="14" TextAlignment="Center" Margin="0,10,0,24"
                                   Text="Mark both eyes and the person on your wallpaper starts watching your cursor."/>
                        <Button Style="{StaticResource PrimaryButton}" Click="OnChoose" HorizontalAlignment="Center" Padding="24,0" Height="44">
                            <TextBlock Text="Choose wallpaper" Foreground="White" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>

                    <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Opacity="0" IsHitTestVisible="False"
                            Background="#EB2C2C2E" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="14" Padding="18,12">
                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                        <TextBlock x:Name="ToastText" FontSize="13"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
