<Window x:Class="Gaze.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:Gaze"
        Title="Gaze" Width="1120" Height="740" MinWidth="940" MinHeight="640"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen"
        Icon="Assets/gaze.ico">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="344"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="24,24,24,16">
                    <TextBlock Text="Gaze" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Desktop eyes that follow your cursor" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel Margin="24,0,24,16">

                        <TextBlock Text="Wallpaper" Style="{StaticResource Section}"/>
                        <Button x:Name="ChooseBtn" Style="{StaticResource SecondaryButton}" Click="OnChoose" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" Margin="0,0,10,0"/>
                                <TextBlock Text="Choose wallpaper"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="FileName" Style="{StaticResource Caption}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="JPG, PNG, WebP or BMP"/>

                        <TextBlock Text="Eyes" Style="{StaticResource Section}" Margin="0,24,0,4"/>
                        <CheckBox x:Name="CyclopsSwitch" Style="{StaticResource Switch}" Content="Cyclops mode (one eye)" Click="OnCyclops"/>
                        <g:LabeledSlider x:Name="SlCyclops" Label="Eye size" Minimum="0.05" Maximum="0.5" Visibility="Collapsed"/>
                        <Border x:Name="EyePicker" Background="{StaticResource Fill}" CornerRadius="10" Padding="2" Margin="0,4,0,0">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="PickLeft" GroupName="eye" Style="{StaticResource SegmentItem}" IsChecked="True" Checked="OnPickEye">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LeftMark" Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Margin="0,0,6,0" Visibility="Collapsed"/>
                                        <TextBlock Text="Left eye"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="PickRight" GroupName="eye" Style="{StaticResource SegmentItem}" Checked="OnPickEye">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="RightMark" Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Margin="0,0,6,0" Visibility="Collapsed"/>
                                        <TextBlock Text="Right eye"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Border>
                        <TextBlock x:Name="EyeHint" Style="{StaticResource Caption}" Margin="2,8,0,12"
                                   Text="Click the centre of the left eye on the photo. Drag a marker to adjust it, or use the arrow keys."/>

                        <g:LabeledSlider x:Name="SlWidth"  Label="Eye width"  Minimum="0.3" Maximum="0.9"/>
                        <g:LabeledSlider x:Name="SlHeight" Label="Eye height" Minimum="0.1" Maximum="0.45"/>
                        <g:LabeledSlider x:Name="SlIris"   Label="Iris size"  Minimum="0.05" Maximum="0.18"/>
                        <g:LabeledSlider x:Name="SlPupil"  Label="Pupil size" Minimum="0.25" Maximum="0.65"/>
                        <g:LabeledSlider x:Name="SlTilt"   Label="Tilt" Minimum="-20" Maximum="20" Scale="1" Unit="°"/>
                        <g:LabeledSlider x:Name="SlLid"    Label="Lid shadow" Minimum="0" Maximum="1"/>
                        <Button Style="{StaticResource QuietButton}" Click="OnAutoFit" HorizontalAlignment="Left" Padding="10,0" Height="32">
                            <TextBlock Text="Auto-fit eye shape"/>
                        </Button>

                        <TextBlock Text="Appearance" Style="{StaticResource Section}" Margin="0,24,0,8"/>
                        <TextBlock Text="Iris colour" FontSize="13"/>
                        <WrapPanel x:Name="IrisSwatches" Margin="0,8,0,8"/>
                        <TextBlock Text="Eye white colour" FontSize="13"/>
                        <WrapPanel x:Name="ScleraSwatches" Margin="0,8,0,8"/>
                        <TextBlock Text="Pupil shape" FontSize="13" Margin="0,0,0,8"/>
                        <Border Background="{StaticResource Fill}" CornerRadius="10" Padding="2">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="PupilRound" GroupName="pupil" Style="{StaticResource SegmentItem}" Content="Round" Checked="OnPupil"/>
                                <RadioButton x:Name="PupilSlit" GroupName="pupil" Style="{StaticResource SegmentItem}" Content="Slit" Checked="OnPupil"/>
                                <RadioButton x:Name="PupilWide" GroupName="pupil" Style="{StaticResource SegmentItem}" Content="Wide" Checked="OnPupil"/>
                            </UniformGrid>
                        </Border>
                        <CheckBox x:Name="GlintSwitch" Style="{StaticResource Switch}" Content="Highlight" Click="OnGlint" Margin="0,4,0,0"/>

                        <TextBlock Text="Tracking" Style="{StaticResource Section}" Margin="0,24,0,8"/>
                        <g:LabeledSlider x:Name="SlSens"   Label="Sensitivity" Minimum="0.4" Maximum="2.5" Scale="100"/>
                        <g:LabeledSlider x:Name="SlRange"  Label="Movement range" Minimum="0.2" Maximum="1"/>
                        <g:LabeledSlider x:Name="SlSmooth" Label="Smoothness" Minimum="0" Maximum="1"/>
                        <CheckBox x:Name="BlinkSwitch" Style="{StaticResource Switch}" Content="Blinking" Click="OnBlink"/>

                        <TextBlock Text="System" Style="{StaticResource Section}" Margin="0,24,0,4"/>
                        <CheckBox x:Name="TrackSwitch" Style="{StaticResource Switch}" Content="Eye tracking" Click="OnTrackingSwitch"/>
                        <CheckBox x:Name="StartSwitch" Style="{StaticResource Switch}" Content="Start with Windows" Click="OnStartSwitch"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="24,16,24,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}" Text="Not applied"/>
                        </StackPanel>
                        <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryButton}" Click="OnApply" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" Margin="0,0,10,0"/>
                                <TextBlock Text="Apply to desktop" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuietButton}" Click="OnReset" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,10,0"/>
                                <TextBlock Text="Reset settings" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Stage -->
        <Grid Grid.Column="1" Margin="28,20,28,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Border Background="{StaticResource Fill}" CornerRadius="10" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeCalibrate" GroupName="mode" Style="{StaticResource SegmentItem}" Content="Calibrate" IsChecked="True" Checked="OnMode"/>
                        <RadioButton x:Name="ModePreview" GroupName="mode" Style="{StaticResource SegmentItem}" Content="Preview" Checked="OnMode"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StageHint" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap"/>
            </Grid>

            <Grid x:Name="StageHost" Grid.Row="1" SizeChanged="OnStageSize">
                <Border x:Name="StageFrame" CornerRadius="12" Background="Black" ClipToBounds="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                    <Grid x:Name="StageGrid" Background="Transparent"
                          MouseLeftButtonDown="OnStageDown" MouseMove="OnStageMove" MouseLeftButtonUp="OnStageUp">
                        <Grid x:Name="SceneHost"/>
                        <Canvas x:Name="Guides" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                    <TextBlock Text="Pick a photo of a face" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" Margin="0,8,0,20"
                               Text="Mark both eyes and the person on your wallpaper starts watching your cursor."/>
                    <Button Style="{StaticResource PrimaryButton}" Click="OnChoose" HorizontalAlignment="Center" Padding="20,0" Height="40">
                        <TextBlock Text="Choose wallpaper" Foreground="White"/>
                    </Button>
                </StackPanel>

                <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Opacity="0" IsHitTestVisible="False"
                        Background="#E62C2C2E" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="16,10">
                    <TextBlock x:Name="ToastText" FontSize="13"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
