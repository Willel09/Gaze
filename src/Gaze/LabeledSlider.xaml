<UserControl x:Class="Gaze.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <TextBlock x:Name="LabelText" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="ValueText" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}"
                       Typography.NumeralAlignment="Tabular"/>
        </Grid>
        <Slider x:Name="S" Grid.Row="1" Margin="0,2,0,0" ValueChanged="OnChanged"/>
    </Grid>
</UserControl>
